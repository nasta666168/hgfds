sp = []
def pish(x):
    global sp
    sp.append(x)
    return
def pap():
    global sp
    temp = sp[-1]
    sp.pop()
    return temp
def bock():
    global sp 
    return sp[-1]
def cloar():
    global sp
    sp.clear()
    return
def soze():
    global sp
    return len(sp)
 
